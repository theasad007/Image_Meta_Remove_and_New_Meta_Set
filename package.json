    "exifreader": "^4.50.0",
    "fflate": "^0.8.3",
    "firebase": "13.0.0",
    "heic-to": "^1.6.6",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.4"
  },
  "optionalDependencies": {
